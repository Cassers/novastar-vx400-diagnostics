@echo off
setlocal DisableDelayedExpansion
rem Prepare only bundled root PowerShell files; never change Windows execution policy.
set "NOVASTAR_PREPARE_ROOT=%~dp0"
"%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -NonInteractive -ExecutionPolicy RemoteSigned -Command "$ErrorActionPreference='Stop'; try { $root=[IO.Path]::GetFullPath($env:NOVASTAR_PREPARE_ROOT); $names=@('Configurar-VxUsuarios.ps1','Control-Vx400.ps1','Control-VxUsuarios.ps1','Export-VxUsuarios.ps1','Install-Vx400Control.ps1','Install-Vx400Watcher.ps1','Install-VxUsuariosStartup.ps1','Invoke-VxLayer.ps1','Play-VxOperatorMedia.ps1','Recover-Vx400.ps1','Recover-VxOperatorUi.ps1','Set-Vx400Manual.ps1','Test-Vx400.ps1','Test-VxConnection.ps1','Vx.Connection.psm1','Vx.Layers.psm1','Vx.Operator.Deployment.psm1','Vx.Operator.psm1','Vx.ProAccess.psm1','Vx.Usb.psm1','Vx400.Automation.psm1','Vx400.Ownership.psm1','Vx400.Protocol.psm1','Vx400.Schedule.psm1','Watch-Vx400.ps1','Watch-Vx400Plan.ps1','Watch-VxOperator.ps1'); foreach($name in $names) { $path=Join-Path $root $name; if(-not [IO.File]::Exists($path)){continue}; $item=Get-Item -LiteralPath $path -Force -ErrorAction Stop; if(($item.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0){throw 'El paquete contiene un enlace de archivo. Extraiga una copia completa.'}; $mark=Get-Item -LiteralPath $path -Stream Zone.Identifier -ErrorAction SilentlyContinue; if($null -ne $mark){Unblock-File -LiteralPath $path -ErrorAction Stop} }; exit 0 } catch { [Console]::Error.WriteLine(('No se pudieron preparar los archivos de NovaStar: '+$_.Exception.Message)); exit 1 }"
exit /b %ERRORLEVEL%
